[Unit]
Description=NDI Monitor Web Control Plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ndi-monitor
Group=ndi-monitor
SupplementaryGroups=video audio render
WorkingDirectory=/opt/ndi-monitor
Environment=NODE_ENV=production
Environment=NDI_MONITOR_CONFIG_PATH=/etc/ndi-receiver/config.yaml
Environment=NDI_MONITOR_RUNTIME_ROOT=/var/lib/ndi-receiver
Environment=NDI_MONITOR_LOG_DIR=/var/log/ndi-receiver
Environment=NDI_MONITOR_RECEIVER_BINARY=/opt/ndi-monitor/apps/receiver/build/ndi-receiver
Environment=XDG_RUNTIME_DIR=/run/ndi-monitor
Environment=SDL_VIDEODRIVER=kmsdrm
Environment=SDL_AUDIODRIVER=alsa
Environment=LD_LIBRARY_PATH=/opt/ndi-monitor/lib
ExecStart=@NODE_BIN@ /opt/ndi-monitor/apps/web/dist/index.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
ReadWritePaths=/etc/ndi-receiver /var/lib/ndi-receiver /var/log/ndi-receiver /run/ndi-monitor
RestrictSUIDSGID=true
LockPersonality=true
UMask=0027

[Install]
WantedBy=multi-user.target
