[Unit]
Description=NDI Monitor HDMI Standby Screen
# Render the standby screen as the very last step of multi-user.target so
# any kernel / systemd / late driver-init output that lands on tty1 during
# boot has already happened and won't scroll our screen away.
After=multi-user.target ndi-web.service network-online.target
Conflicts=getty@tty1.service

[Service]
Type=oneshot
User=root
ExecStart=/opt/ndi-monitor/scripts/standby-screen.sh
RemainAfterExit=yes
TimeoutStartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/dev/tty1

[Install]
WantedBy=multi-user.target
