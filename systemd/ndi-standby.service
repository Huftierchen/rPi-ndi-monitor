[Unit]
Description=NDI Monitor HDMI Standby Screen
After=local-fs.target
Before=ndi-web.service
Conflicts=getty@tty1.service

[Service]
Type=oneshot
User=root
ExecStart=/opt/ndi-monitor/scripts/standby-screen.sh
RemainAfterExit=yes
TimeoutStartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/dev/tty1

[Install]
WantedBy=multi-user.target
